{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yueke.example/contracts/lab-runtime-v1.schema.json",
  "title": "跃科实验运行请求 v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["lab_release_id", "lab_version_id", "mode"],
  "properties": {
    "lab_release_id": {"type": "string", "minLength": 1, "maxLength": 36},
    "lab_version_id": {"type": "string", "minLength": 1, "maxLength": 36},
    "course_id": {"type": ["string", "null"], "maxLength": 36},
    "class_id": {"type": ["string", "null"], "maxLength": 36},
    "student_id": {"type": ["string", "null"], "maxLength": 36},
    "mode": {"enum": ["STUDENT", "TEACHER_PREVIEW"]},
    "requested_by": {"type": ["string", "null"], "maxLength": 36},
    "idempotency_key": {"type": ["string", "null"], "minLength": 8, "maxLength": 255}
  },
  "allOf": [
    {"if": {"properties": {"mode": {"const": "STUDENT"}}}, "then": {"required": ["student_id"]}},
    {"if": {"properties": {"mode": {"const": "TEACHER_PREVIEW"}}}, "then": {"required": ["requested_by", "idempotency_key"]}}
  ]
}
